    <!-- Info Screen -->
    <string name="info_what_title">功能介绍</string>
    <string name="info_what_p1">将 SD1.5 和 SDXL 图像生成模型转换为可在手机高通 AI 处理器 (NPU) 上直接运行的格式。</string>
    <string name="info_what_p2">应用内置了预编译优化的模型拓扑结构，在手机上将目标模型的权重填入其中并生成最终的 NPU 二进制文件。</string>

    <string name="info_scope_title">支持范围</string>
    <string name="info_scope_b1">• 单文件 .safetensors 格式检查点模型</string>
    <string name="info_scope_b2">• SD1.5：512 × 512 分辨率，目标芯片骁龙 8 Gen 2 (v73)</string>
    <string name="info_scope_b3">• SDXL：1024 × 1024 分辨率，目标芯片骁龙 8 Gen 3 (v75)</string>
    <string name="info_scope_b4">• QAIRT 2.50；SDXL UNet 采用 INT8 权重与 16 位激活值</string>
    <string name="info_scope_b5">• 包含共享的 VAE 编码器与解码器，支持文生图和图生图</string>

    <string name="info_converted_title">转换与复用组件</string>
    <string name="info_converted_p1">转换过程替换检查点模型中的 UNet 网络。SD1.5 首次使用时会下载一次共享的 DreamShaper 文本编码器与 VAE。</string>
    <string name="info_converted_p2">SDXL 共享组件从 Mr-J-369 的 SDXL-OnDevice-Conversion 仓库下载一次（约 1 GB），应用将保存其 MNN 文本编码器和 QNN VAE 编解码器供后续复用。</string>
    <string name="info_converted_p3">当前 SDXL 组件基于 madebyollin/sdxl-vae-fp16-fix、QAIRT 2.50 与 1024 × 1024 v75 VAE 构建。提示词解析与色彩倾向遵循共享组件。</string>

    <string name="info_compatibility_title">模型兼容性</string>
    <string name="info_compatibility_p1">CyberRealistic、DreamShaper 8 和 AbsoluteReality 均已验证可正常转换并生成图像。MistoonAnime 在实测中虽转换成功，但出图呈现噪点。</string>
    <string name="info_compatibility_p2">模板复用了校准后的动态范围，适用性因模型权重分布而异；MistoonAnime 的结果并不代表所有二次元动漫模型均无法使用。</string>

    <string name="info_lora_title">LoRA 适配器</string>
    <string name="info_lora_p1">LoRA 权重在转换阶段直接与主模型融合，因此在生图推理时完全不增加额外耗时。支持单次合并多个 LoRA。</string>
    <string name="info_lora_p2">支持格式：标准 kohya LoRA (lora_down / lora_up / alpha)。</string>
    <string name="info_lora_p3">暂不支持：diffusers/PEFT 格式、LoCon、LyCORIS、LoHa、DoRA、IA3。遇到此类格式会直接提示错误，避免产生损坏模型。</string>
    <string name="info_lora_p4">目前已验证注意力模块 (attention)；卷积模块理论可行但尚未实测验证。</string>
    <string name="info_lora_p5">转换会丢弃 LoRA 的文本编码器部分，因此画风风格类 LoRA 的表现通常好于依赖特定触发词的 LoRA。</string>
    <string name="info_lora_p6">权重强度在转换时固化到模型中：调整强度需要重新转换一次模型。</string>

    <string name="info_requirements_title">设备与系统要求</string>
    <string name="info_requirements_b1">• arm64 架构，Android 13 或更高版本系统</string>
    <string name="info_requirements_b2">• 早期 SD1.5 转换实测峰值内存占用约 4.8 GB</string>
    <string name="info_requirements_b3">• SD1.5 转换过程需要约 4 GB 可用存储空间</string>
    <string name="info_requirements_b4">• SD1.5 导出大小约 1.3 GB；实测 SDXL 导出压缩包约 3.5 GB</string>
    <string name="info_requirements_b5">• 实测 SDXL O=3 优化转换耗时 7 分 17 秒</string>
    <string name="info_requirements_b6">• SDXL 通过存储暂存机制降低运行内存占用，需预留充足剩余存储空间</string>
    <string name="info_requirements_b7">• SDXL 手机端峰值内存消耗尚未完全测定</string>

    <string name="info_troubleshooting_title">常见异常与排查</string>
    <string name="info_troubleshooting_p1">生成画面出现高饱和斑驳噪点，通常表示该模型的权重分布超出了模板的校准激活范围。</string>
    <string name="info_troubleshooting_p2">模型能否成功加载取决于目标芯片架构以及生图软件内的 QNN 运行库版本。</string>
    <string name="info_troubleshooting_p3">提示词解析不符合预期通常与共享的 CLIP 文本编码器相关。</string>
    <string name="info_troubleshooting_p4">色彩或细节异常需要具体日志分析，仅凭外观画面无法直接判定原因。</string>

    <string name="info_tested_title">实机测试记录</string>
    <string name="info_tested_p1">测试设备：Samsung Galaxy S25 Ultra (SM8750，Hexagon v79)。SD1.5 与 SDXL 转换及生成均已测试成功。</string>
    <string name="info_tested_p2">SDXL O=3 产物在 Aura 中 1024 × 1024、8 步、CFG 1、LCM/Karras 条件下实测出图用时 15 秒（单次运行数据，非多机型基准对比）。</string>
</resources>
