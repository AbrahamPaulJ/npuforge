    <!-- Info Screen -->
    <string name="info_use_title">Use your converted model</string>
    <string name="info_use_body">Convert an SD1.5 or SDXL .safetensors checkpoint, then import the ZIP from Download/npuforge into Local Dream or Fancy AI. Conversion works offline.</string>
    <string name="info_black_title">Black images with SDXL?</string>
    <string name="info_black_body">If conversion succeeds but images come out black, try replacing the VAE:</string>
    <string name="info_black_step1">1. Download and extract VAE.zip using the button below.</string>
    <string name="info_black_step2">2. In your converted model ZIP, replace both vae_encoder.bin and vae_decoder.bin with the files from VAE.zip. Keep their names and locations unchanged.</string>
    <string name="info_black_step3">3. Save the updated model ZIP and import it again into Local Dream or Fancy AI. You do not need to reconvert the checkpoint.</string>
    <string name="info_black_download">Download SDXL VAE</string>
    <string name="info_formats_title">Models and LoRAs</string>
    <string name="info_formats_body">SD1.5 and SDXL checkpoints support F16, F32 and BF16 weights. Add UNet LoRAs before converting; their strengths are baked into the exported model. Text-encoder LoRA weights are not merged.</string>
    <string name="info_help_title">Conversion failed?</string>
    <string name="info_help_body">Use “Save full troubleshooting log” on the Convert tab. Include the log, phone model and checkpoint name when reporting the problem.</string>

