<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The conversion runs ~117 s and the compile peaks around 4.8 GB; a
         backgrounded app in that state is what Android kills. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- arm64 only: the models this produces run on Qualcomm's HTP. -->
    <uses-feature android:name="android.hardware.ram.normal" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_manage"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.Npuforge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ConvertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
