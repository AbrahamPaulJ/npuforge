<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay: lets `adb shell am start-foreground-service` drive a
     conversion, so the end-to-end path can be tested without a human tapping
     through the SAF picker.

     DUMP restricts these debug entry points to privileged callers such as ADB
     shell. Ordinary apps cannot start them, including in shared debug APKs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name=".ConvertService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:replace="android:exported" />
        <!-- Debug-only DSP reachability probe; see ProbeService. -->
        <service android:name=".ProbeService" android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
